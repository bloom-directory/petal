package bloom:sign@0.4.0;

interface signing {
  record approval-pending {
    action-id: string,
    expires-ms: u64,
  }

  variant sign-result {
    signature(list<u8>),
    approval-pending(approval-pending),
  }

  enum selector { exact, reusable }

  record payload-sign-request {
    wallet: string,
    preimage: list<u8>,
    claimed-hash: list<u8>,
    signature-algorithm: string,
    operation-class: string,
    petal-use-claim-jcs: list<u8>,
    claim-assurance-evidence: option<list<u8>>,
    approval-hint: option<string>,
    action: option<list<u8>>,
    advisory: option<list<u8>>,
    selector: selector,
    key-ref-jcs: option<list<u8>>,
  }

  record payload-sign-item {
    preimage: list<u8>,
    claimed-hash: list<u8>,
  }

  record payload-batch-sign-request {
    wallet: string,
    /// Ordered and atomic. The claim payload digest is SHA-256 over
    /// "bloom.petal.payload-batch.v1\0", the u64-BE item count, then each
    /// u64-BE preimage length and exact preimage bytes in this order.
    payloads: list<payload-sign-item>,
    signature-algorithm: string,
    operation-class: string,
    petal-use-claim-jcs: list<u8>,
    claim-assurance-evidence: option<list<u8>>,
    approval-hint: option<string>,
    action: option<list<u8>>,
    advisory: option<list<u8>>,
    selector: selector,
    key-ref-jcs: option<list<u8>>,
  }

  variant sign-batch-result {
    signatures(list<list<u8>>),
    approval-pending(approval-pending),
  }

  sign-payload: func(request: payload-sign-request) -> result<sign-result, string>;
  sign-payload-batch: func(request: payload-batch-sign-request) -> result<sign-batch-result, string>;
}
